{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/partner-exchange/report-submission.schema.json",
  "title": "National report submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["partnerId", "unitId", "callsign", "latitude", "longitude", "status", "observedAt"],
  "properties": {
    "partnerId": { "type": "string", "pattern": "^[A-Z]{3,8}$" },
    "unitId": { "type": "string", "pattern": "^[A-Z0-9-]{1,16}$" },
    "callsign": { "type": "string", "pattern": "^[A-Z0-9]{1,12}$" },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "altitudeMetres": { "type": ["integer", "null"], "minimum": 0, "maximum": 9999 },
    "speedKnots": { "type": ["integer", "null"], "minimum": 0, "maximum": 999 },
    "status": { "enum": ["FullyOperational", "Degraded", "OutOfService"] },
    "readiness": { "enum": ["Immediate", "High", "Medium", "Low", null] },
    "observedAt": { "type": "string", "format": "date-time" }
  }
}
